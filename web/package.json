{
  "name": "bm3d-viewer",
  "version": "1.1.1",
  "description": "A three.js viewer for bm3d models: streams the nodes it needs of a .bm3d file with HTTP Range requests and decodes them in a worker.",
  "license": "MIT",
  "author": "Digipa",
  "homepage": "https://github.com/DroneDB/bm3d",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DroneDB/bm3d.git",
    "directory": "web"
  },
  "type": "module",
  "main": "./dist/bm3d-viewer.js",
  "module": "./dist/bm3d-viewer.js",
  "exports": {
    ".": "./dist/bm3d-viewer.js",
    "./min": "./dist/bm3d-viewer.min.js",
    "./corto-worker.js": "./dist/corto-worker.js",
    "./corto.wasm": "./dist/corto.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/bm3d-viewer.js",
    "dist/bm3d-viewer.min.js",
    "dist/corto-worker.js",
    "dist/corto.wasm",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build:wasm": "bash corto-wasm/build.sh",
    "build": "rollup --config",
    "pretest": "rollup --config",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@rollup/plugin-terser": "1.0.0",
    "rollup": "4.64.3",
    "three": "0.180.0",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "rolldown": "1.2.13",
    "postcss": "8.5.29",
    "magic-string": "1.4.3",
    "serialize-javascript": "7.1.2",
    "@oxc-project/types": "0.153.0"
  }
}
