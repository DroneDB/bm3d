@PACKAGE_INIT@

# The static libraries of bm3d link these; a program that links bm3d::bm3d needs them found.
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(JPEG)
if(@BM3D_WITH_TIFF@)
    find_dependency(TIFF)
endif()
find_dependency(WebP CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/bm3dTargets.cmake")
