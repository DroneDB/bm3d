From 42b35dd492bbc0a32a7dd914a402af88196e96dc Mon Sep 17 00:00:00 2001
From: HeDo <ldileo@digipa.it>
Date: Sun, 25 Oct 2026 20:21:27 +0100
Subject: [PATCH 4/4] plylib reads the length of a binary list as the type the
 header declares

PLY lets a list give its length as any integer type: "property list int int vertex_indices"
is valid, and some writers use it. The binary list readers read the length as one byte
whatever the header said (only the int-to-int reader looked at the type, and it did not know
ushort), so such a file was misread from its first list on; the readers that skip a list
nobody asked for did the same. All of them now read the length through one function,
ReadListLengthB, which reads the declared type (char, uchar, short, ushort, int or uint, in
the file's byte order) and fails the read for any other type, a negative length or one
beyond int. compile() gives a list property it will skip the type of its length too, since
AddToRead fills in the descriptor only for the properties it reads. Lists of uchar length
read exactly as before.
---
 wrap/ply/plylib.cpp | 268 +++++++++++++++++++++++---------------------
 1 file changed, 140 insertions(+), 128 deletions(-)

diff --git a/wrap/ply/plylib.cpp b/wrap/ply/plylib.cpp
index c9bd03e50..a0e46593b 100644
--- a/wrap/ply/plylib.cpp
+++ b/wrap/ply/plylib.cpp
@@ -60,6 +60,7 @@ extern "C" __declspec(dllimport) int __stdcall MultiByteToWideChar(unsigned int,
 #include <math.h>
 #include <string.h>
 #include <assert.h>
+#include <limits.h>
 
 #include <vector>
 #include <algorithm>
@@ -1932,21 +1933,38 @@ static bool cb_read_ascii( GZFILE fp, void * mem, PropDescriptor * d )
 }
 
 
+// The length of a binary list, read as the type the header declares for it: most files give it
+// as an uchar, but any integer type is valid PLY (some writers use int or uint), and reading one
+// byte of a wider length misreads the list and everything after it. False when the file ends,
+// the type is not an integer one, or the length is negative or beyond int.
+static inline bool ReadListLengthB( GZFILE fp, const PropDescriptor * d, int & n )
+{
+	switch(d->stotype2)
+	{
+	case T_CHAR: case T_UCHAR: case T_SHORT: case T_USHORT: case T_INT: case T_UINT: break;
+	default: return false;
+	}
+	double length;
+	if( !ReadScalarB(fp,&length,d->stotype2,T_DOUBLE,d->format) ) return false;
+	if( length<0 || length>double(INT_MAX) ) return false;
+	n = int(length);
+	return true;
+}
+
 const int SKIP_MAX_BUF = 512;
 
-// Discard one binary list property: a uchar count followed by n elements of
-// elemSize bytes. The count reaches 255, so a single pb_fread of n*elemSize bytes
+// Discard one binary list property: a count (of the type the header declares, see
+// ReadListLengthB) followed by n elements of elemSize bytes. A single pb_fread of n*elemSize bytes
 // overruns skip_buf as soon as the list is longer than SKIP_MAX_BUF/elemSize --
 // 128 entries for uint32 lists, 64 for 8-byte ones. That is a stack smash driven
 // straight from file contents, so the skip is chunked instead.
 // An empty list is not an error either: the old code asked fread for zero items,
 // got zero back and reported failure.
-static bool cb_skip_list_bin( GZFILE fp, int elemSize )
+static bool cb_skip_list_bin( GZFILE fp, const PropDescriptor * d, int elemSize )
 {
   char skip_buf[SKIP_MAX_BUF];
-  uchar n;
-		// Solo indici uchar
-	if( pb_fread(&n,1,1,fp)==0 ) return false;
+  int n;
+	if( !ReadListLengthB(fp,d,n) ) return false;
 
 	size_t remaining = size_t(n) * size_t(elemSize);
 	while( remaining > 0 )
@@ -1958,24 +1976,24 @@ static bool cb_skip_list_bin( GZFILE fp, int elemSize )
 	return true;
 }
 
